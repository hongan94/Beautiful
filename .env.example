RAILS_ENV=production
RACK_ENV=production
RAILS_LOG_TO_STDOUT=true
SECRET_KEY_BASE=your_secret_key_base_here

# PostgreSQL Database Configuration
BEAUTIFUL_DATABASE_USERNAME=beautiful
